class Solution:
    def palindromePath(self, n: int, edges: list[list[int]], s: str, queries: list[str]) -> list[bool]:
        graph = [[] for _ in range(n)]

        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)

        parent = [-1] * n
        depth = [0] * n
        order = [0]
        parent[0] = 0

        # Build parent and depth iteratively
        for u in order:
            for v in graph[u]:
                if parent[v] == -1:
                    parent[v] = u
                    depth[v] = depth[u] + 1
                    order.append(v)

        # Calculate subtree sizes and heavy child
        size = [1] * n
        heavy = [-1] * n

        for u in reversed(order):
            largest = 0

            for v in graph[u]:
                if parent[v] == u:
                    size[u] += size[v]

                    if size[v] > largest:
                        largest = size[v]
                        heavy[u] = v

        # Heavy-Light Decomposition
        head = [0] * n
        pos = [0] * n
        timer = 0
        stack = [(0, 0)]

        while stack:
            u, h = stack.pop()

            while u != -1:
                head[u] = h
                pos[u] = timer
                timer += 1

                for v in graph[u]:
                    if parent[v] == u and v != heavy[u]:
                        stack.append((v, v))

                u = heavy[u]

        # Iterative segment tree using XOR
        size_seg = 1
        while size_seg < n:
            size_seg *= 2

        seg = [0] * (2 * size_seg)

        chars = list(s)

        for u in range(n):
            seg[size_seg + pos[u]] = 1 << (ord(chars[u]) - ord('a'))

        for i in range(size_seg - 1, 0, -1):
            seg[i] = seg[2 * i] ^ seg[2 * i + 1]

        def update(u, c):
            chars[u] = c
            i = size_seg + pos[u]
            seg[i] = 1 << (ord(c) - ord('a'))
            i //= 2

            while i:
                seg[i] = seg[2 * i] ^ seg[2 * i + 1]
                i //= 2

        def range_xor(left, right):
            left += size_seg
            right += size_seg
            result = 0

            while left <= right:
                if left & 1:
                    result ^= seg[left]
                    left += 1

                if not (right & 1):
                    result ^= seg[right]
                    right -= 1

                left //= 2
                right //= 2

            return result

        def path_xor(u, v):
            result = 0

            while head[u] != head[v]:
                if depth[head[u]] < depth[head[v]]:
                    u, v = v, u

                result ^= range_xor(pos[head[u]], pos[u])
                u = parent[head[u]]

            if depth[u] > depth[v]:
                u, v = v, u

            result ^= range_xor(pos[u], pos[v])
            return result

        answer = []

        for q in queries:
            parts = q.split()

            if parts[0] == "update":
                u = int(parts[1])
                c = parts[2]
                update(u, c)

            else:
                u = int(parts[1])
                v = int(parts[2])

                mask = path_xor(u, v)
                answer.append((mask & (mask - 1)) == 0)

        return answer
