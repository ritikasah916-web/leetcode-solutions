class Solution:
    def minOperations(self, nums: List[int], x: int, k: int) -> int:
        from typing import List
        n = len(nums)

        vals = sorted(set(nums))
        m = len(vals)
        pos = {v: i + 1 for i, v in enumerate(vals)}

        class Fenwick:
            def __init__(self):
                self.count = [0] * (m + 1)
                self.total = [0] * (m + 1)

            def add(self, i, c, s):
                while i <= m:
                    self.count[i] += c
                    self.total[i] += s
                    i += i & -i

            def query(self, bit, i):
                ans = 0
                while i:
                    ans += bit[i]
                    i -= i & -i
                return ans

            def kth(self, k):
                idx = 0
                step = 1 << (m.bit_length() - 1)

                while step:
                    nxt = idx + step
                    if nxt <= m and self.count[nxt] < k:
                        idx = nxt
                        k -= self.count[nxt]
                    step >>= 1

                return idx + 1

        bit = Fenwick()
        total = 0

        for v in nums[:x]:
            bit.add(pos[v], 1, v)
            total += v

        costs = []

        for start in range(n - x + 1):
            mid = bit.kth((x + 1) // 2)
            median = vals[mid - 1]

            cnt = bit.query(bit.count, mid)
            sm = bit.query(bit.total, mid)

            cost = median * cnt - sm
            cost += total - sm - median * (x - cnt)

            costs.append(cost)

            if start < n - x:
                old = nums[start]
                new = nums[start + x]

                bit.add(pos[old], -1, -old)
                bit.add(pos[new], 1, new)

                total += new - old

        INF = float('inf')
        prev = [0] * (n + 1)

        for j in range(1, k + 1):
            curr = [INF] * (n + 1)

            for i in range(1, n + 1):
                curr[i] = curr[i - 1]

                if i >= x:
                    start = i - x
                    curr[i] = min(
                        curr[i],
                        prev[start] + costs[start]
                    )

            prev = curr

        return prev[n]