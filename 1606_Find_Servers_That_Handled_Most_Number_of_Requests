class Solution:
    def busiestServers(self, k: int, arrival: list[int], load: list[int]) -> list[int]:
        size = 1
        while size < k:
            size *= 2

        tree = [0] * (2 * size)

        for i in range(k):
            tree[size + i] = 1

        for i in range(size - 1, 0, -1):
            tree[i] = tree[2 * i] + tree[2 * i + 1]

        def update(pos, val):
            pos += size
            tree[pos] = val

            while pos > 1:
                pos //= 2
                tree[pos] = tree[2 * pos] + tree[2 * pos + 1]

        def find_first(start):

            def search(node, left, right):
                if right <= start or tree[node] == 0:
                    return -1

                if right - left == 1:
                    return left if left < k else -1

                mid = (left + right) // 2

                ans = search(node * 2, left, mid)

                if ans != -1:
                    return ans

                return search(node * 2 + 1, mid, right)

            return search(1, 0, size)

        busy = []
        count = [0] * k

        for i in range(len(arrival)):

            while busy and busy[0][0] <= arrival[i]:
                end_time, server = heapq.heappop(busy)
                update(server, 1)

            server = find_first(i % k)

            if server == -1:
                server = find_first(0)

            if server == -1:
                continue

            count[server] += 1
            update(server, 0)

            heapq.heappush(
                busy,
                (arrival[i] + load[i], server)
            )

        maximum = max(count)

        return [i for i in range(k) if count[i] == maximum]