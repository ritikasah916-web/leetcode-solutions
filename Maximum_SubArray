class Solution:
    def maxSubArray(self, nums: list[int]) -> int:
        if not nums:
            return 0
            
        current_sum = nums[0]
        max_sum = nums[0]
        
        for i in range(1, len(nums)):
            num = nums[i]
            
            if current_sum + num > num:
                current_sum = current_sum + num
            else:
                current_sum = num
                
            if current_sum > max_sum:
                max_sum = current_sum
                
        return max_sum